#!/bin/bash
# Pre-push hook for ISOInspector
# This hook runs before pushing to ensure code quality and strict concurrency compliance
# Install: git config core.hooksPath .githooks

set -eo pipefail

echo "🔍 Running pre-push quality checks..."
echo ""

# Colors for output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FAILED=0

# Optional paths live in the current worktree's Git directory, not in the repository.
# Environment variables take precedence over this local configuration.
BUILD_CONFIG="$(git rev-parse --absolute-git-dir)/isoinspector-build.conf"
if [[ -e "$BUILD_CONFIG" ]] && ! git config --file "$BUILD_CONFIG" --list > /dev/null; then
    echo "❌ Invalid build path configuration: $BUILD_CONFIG"
    exit 1
fi
build_config_value() {
    git config --file "$BUILD_CONFIG" --get "$1" 2>/dev/null || :
}
ROOT_SCRATCH=${ISOINSPECTOR_SWIFTPM_SCRATCH_PATH:-$(build_config_value build.rootScratch)}
FOUNDATION_SCRATCH=${ISOINSPECTOR_FOUNDATIONUI_SCRATCH_PATH:-$(build_config_value build.foundationScratch)}
SWIFTPM_CACHE=${ISOINSPECTOR_SWIFTPM_CACHE_PATH:-$(build_config_value build.cache)}
BUILD_PREFLIGHT=${ISOINSPECTOR_BUILD_PREFLIGHT:-$(build_config_value build.preflight)}

ROOT_SWIFT_OPTIONS=()
FOUNDATION_SWIFT_OPTIONS=()
if [[ -n "$ROOT_SCRATCH$FOUNDATION_SCRATCH$SWIFTPM_CACHE$BUILD_PREFLIGHT" ]]; then
    if [[ -z "$ROOT_SCRATCH" || -z "$FOUNDATION_SCRATCH" || -z "$SWIFTPM_CACHE" ]]; then
        echo "❌ Configure root scratch, FoundationUI scratch, and SwiftPM cache together."
        exit 1
    fi
    if [[ "$ROOT_SCRATCH" == "$FOUNDATION_SCRATCH" ]]; then
        echo "❌ Root and FoundationUI packages require separate scratch paths."
        exit 1
    fi
    if [[ -n "$BUILD_PREFLIGHT" ]]; then
        if [[ ! -x "$BUILD_PREFLIGHT" ]] || ! "$BUILD_PREFLIGHT" "$(pwd)" || ! "$BUILD_PREFLIGHT" "$(pwd)/FoundationUI"; then
            echo "❌ Build path preflight failed; refusing to fall back to local artifacts."
            exit 1
        fi
    fi
    for build_path in "$ROOT_SCRATCH" "$FOUNDATION_SCRATCH" "$SWIFTPM_CACHE"; do
        if [[ ! -d "$build_path" || ! -w "$build_path" ]]; then
            echo "❌ Build path is unavailable or not writable: $build_path"
            exit 1
        fi
    done
    ROOT_SWIFT_OPTIONS=(--scratch-path "$ROOT_SCRATCH" --cache-path "$SWIFTPM_CACHE")
    FOUNDATION_SWIFT_OPTIONS=(--scratch-path "$FOUNDATION_SCRATCH" --cache-path "$SWIFTPM_CACHE")
fi

# Check if we're pushing to main
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
PUSH_REMOTE=$(git config --get branch.${CURRENT_BRANCH}.remote 2>/dev/null || echo "origin")

echo "📋 Pre-push Quality Gate Checklist"
echo "=================================="
echo ""

# 1. Check for SwiftLint violations (if installed)
echo "1️⃣  Checking code quality with SwiftLint (strict mode)..."
if command -v swiftlint &> /dev/null; then
    if swiftlint lint --strict --quiet --baseline .swiftlint.baseline.json; then
        echo -e "${GREEN}✅ SwiftLint check passed${NC}"
    else
        echo -e "${RED}❌ SwiftLint violations found${NC}"
        echo "   Run: swiftlint lint --strict --baseline .swiftlint.baseline.json"
        echo "   Fix auto-fixable issues: swiftlint --fix"
        FAILED=$((FAILED + 1))
    fi
else
    echo -e "${YELLOW}⚠️  SwiftLint not installed (optional)${NC}"
    echo "   Install: brew install swiftlint"
fi
echo ""

# 2. Verify strict concurrency compliance (build)
echo "2️⃣  Verifying strict concurrency compliance (build)..."
LOG_DIR="Documentation/Quality"
mkdir -p "$LOG_DIR"
BUILD_LOG="$LOG_DIR/strict-concurrency-build-$(date +%Y%m%d-%H%M%S).log"

if swift build --target ISOInspectorKit "${ROOT_SWIFT_OPTIONS[@]}" 2>&1 | tee "$BUILD_LOG"; then
    echo -e "${GREEN}✅ Build with strict concurrency passed${NC}"
    echo "   Log: $BUILD_LOG"
else
    echo -e "${RED}❌ Build with strict concurrency failed${NC}"
    echo "   Log: $BUILD_LOG"
    echo "   Review the log for concurrency violations"
    FAILED=$((FAILED + 1))
fi
echo ""

# 3. Verify strict concurrency compliance (tests)
echo "3️⃣  Verifying strict concurrency compliance (tests)..."
TEST_LOG="$LOG_DIR/strict-concurrency-test-$(date +%Y%m%d-%H%M%S).log"

if swift test --filter ISOInspectorKitTests "${ROOT_SWIFT_OPTIONS[@]}" 2>&1 | tee "$TEST_LOG"; then
    echo -e "${GREEN}✅ Tests with strict concurrency passed${NC}"
    echo "   Log: $TEST_LOG"
else
    echo -e "${RED}❌ Tests with strict concurrency failed${NC}"
    echo "   Log: $TEST_LOG"
    echo "   Review the log for concurrency violations"
    FAILED=$((FAILED + 1))
fi
echo ""

# 4. Check test coverage threshold (FoundationUI)
echo "4️⃣  Checking test coverage threshold..."
COVERAGE_THRESHOLD=${ISOINSPECTOR_MIN_TEST_COVERAGE:-0.67}
COVERAGE_TEST_LOG="$LOG_DIR/foundationui-coverage-test-$(date +%Y%m%d-%H%M%S).log"
COVERAGE_REPORT="$LOG_DIR/foundationui-coverage-report-$(date +%Y%m%d-%H%M%S).txt"

PLATFORM=$(uname -s)
if [[ "$PLATFORM" != "Darwin" ]]; then
    echo -e "${YELLOW}⚠️  FoundationUI coverage requires macOS SwiftUI SDKs; skipping on $PLATFORM${NC}"
else
    echo "   Running FoundationUI tests with coverage..."
    if swift test --package-path FoundationUI --enable-code-coverage "${FOUNDATION_SWIFT_OPTIONS[@]}" 2>&1 | tee "$COVERAGE_TEST_LOG"; then
        echo -e "${GREEN}✅ FoundationUI tests with coverage passed${NC}"
        echo "   Log: $COVERAGE_TEST_LOG"

        if command -v python3 &> /dev/null; then
            if python3 coverage_analysis.py --threshold "$COVERAGE_THRESHOLD" --report "$COVERAGE_REPORT" -v; then
                echo -e "${GREEN}✅ Test coverage check passed${NC}"
                echo "   Threshold: $COVERAGE_THRESHOLD (67%)"
                echo "   Report: $COVERAGE_REPORT"
            else
                echo -e "${RED}❌ Test coverage below threshold${NC}"
                echo "   Threshold: $COVERAGE_THRESHOLD (67%)"
                echo "   Report: $COVERAGE_REPORT"
                echo "   For guidance, see Documentation/ISOInspector.docc/Guides/TestingAndCoverage.md"
                FAILED=$((FAILED + 1))
            fi
        else
            echo -e "${YELLOW}⚠️  Python3 not available, skipping coverage check${NC}"
        fi
    else
        echo -e "${RED}❌ FoundationUI tests with coverage failed${NC}"
        echo "   Log: $COVERAGE_TEST_LOG"
        FAILED=$((FAILED + 1))
    fi
fi
echo ""

# 5. Swift duplication guard
echo "5️⃣  Checking Swift duplication guard (jscpd @3.5.10)..."
DUP_REPORT="$LOG_DIR/swift-duplication-report-$(date +%Y%m%d-%H%M%S).txt"

if command -v node &> /dev/null && command -v npx &> /dev/null; then
    if REPORT_PATH="$DUP_REPORT" ./scripts/run_swift_duplication_check.sh; then
        echo -e "${GREEN}✅ Swift duplication check passed${NC}"
        echo "   Report: $DUP_REPORT"
    else
        echo -e "${RED}❌ Swift duplication check failed${NC}"
        echo "   Threshold: ≤1% overall duplication, clones <45 lines"
        echo "   Report: $DUP_REPORT"
        echo "   See DOCS/AI/github-workflows/02_swift_duplication_guard/prd.md for remediation guidance"
        FAILED=$((FAILED + 1))
    fi
else
    echo -e "${RED}❌ Node.js (npx) not available; duplication gate is required${NC}"
    echo "   Install Node 20+ (same as CI) to run scripts/run_swift_duplication_check.sh"
    FAILED=$((FAILED + 1))
fi
echo ""

# 6. Check for large files in commits being pushed
echo "6️⃣  Checking for large files in commits being pushed..."
# Check commits between remote main and current branch
MERGE_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "HEAD")
LARGE_FILES=$(git diff $MERGE_BASE...HEAD --name-only --diff-filter=ACM | while read file; do
    if [ -f "$file" ]; then
        # Use wc -c for cross-platform compatibility (works on macOS and Linux)
        SIZE=$(wc -c < "$file" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt 10485760 ]; then  # 10MB
            echo "$file ($((SIZE/1048576))MB)"
        fi
        fi
    done)

if [ -z "$LARGE_FILES" ]; then
    echo -e "${GREEN}✅ No large files detected${NC}"
else
    echo -e "${YELLOW}⚠️  Large files detected:${NC}"
    echo "$LARGE_FILES"
    echo "   Consider using Git LFS for binary files"
fi
echo ""

# 7. Check for secrets in commits being pushed
echo "7️⃣  Scanning for secrets in commits being pushed..."
SECRETS_FOUND=0
MERGE_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "HEAD")
for commit in $(git rev-list $MERGE_BASE...HEAD); do
    if git show "$commit" | grep -qE 'API[_-]?KEY|PASSWORD|SECRET|TOKEN|PRIVATE[_-]?KEY'; then
        echo -e "${RED}⚠️  Potential secret in commit: $commit${NC}"
        SECRETS_FOUND=$((SECRETS_FOUND + 1))
    fi
done

if [ "$SECRETS_FOUND" -eq 0 ]; then
    echo -e "${GREEN}✅ No secrets detected${NC}"
else
    echo -e "${RED}❌ Potential secrets found - do not push!${NC}"
    FAILED=$((FAILED + 1))
fi
echo ""

# Summary
echo "=================================="
if [ "$FAILED" -eq 0 ]; then
    echo -e "${GREEN}✅ All pre-push checks passed!${NC}"
    echo "Proceeding with push to $PUSH_REMOTE..."
    exit 0
else
    echo -e "${RED}❌ Pre-push checks failed ($FAILED issues)${NC}"
    echo ""
    echo "Next steps:"
    echo "1. Fix the issues listed above"
    echo "2. Stage your changes: git add ."
    echo "3. Try pushing again: git push"
    echo ""
    echo "To bypass (not recommended): git push --no-verify"
    exit 1
fi
